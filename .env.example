# Copy to .env and fill in. .env is gitignored.
# Required for the Auto-Compose agent (✨ التأليف التلقائي).
OPENAI_API_KEY=sk-...

# Flagship by default; override to gpt-5.5-pro (higher) or gpt-5.4-mini (cheaper).
OPENAI_MODEL=gpt-5.5

# Optional fixed temperature. Leave unset for GPT-5.x reasoning models (they reject it).
# OPENAI_TEMPERATURE=0.7

# Memory safety defaults for local TTS workers.
# Keep only one heavyweight Python model loaded at a time through the gateway.
TTS_SINGLE_MODEL=1
# Unload idle Python models after 15 minutes. Set 0 to disable idle unload.
TTS_MODEL_IDLE_SECONDS=900
# Reject oversized synthesis requests before they can fill RAM.
TTS_MAX_REQUEST_BYTES=33554432
TTS_MAX_UPLOAD_BYTES=26214400
TTS_MAX_TEXT_CHARS=8000

# ── Request log (📊 سجل الطلبات, logs.html) ──────────────────────
# Every /api/ call is recorded — inputs, outputs, status and elapsed time. Uploaded
# files are stored by name and size only; their contents never touch the database.
TTS_LOG_REQUESTS=1
# Rows kept; the oldest are dropped past this. Default: 5000
TTS_LOG_RETENTION=5000
# Where the SQLite file lives. Default: $TTS_WORKDIR/logs/requests.db
# TTS_LOG_DB=
# Record the UI's status-polling calls too (noisy — off by default).
TTS_LOG_STATUS_POLLS=0
# Bytes captured from each end of a body, and the caps on what is stored per field/row.
# TTS_LOG_MAX_BODY_BYTES=16384
# TTS_LOG_MAX_FIELD_CHARS=1000
# TTS_LOG_MAX_SUMMARY_CHARS=4000

# Root of the TTS training/work project (holds outputs_* dirs and the
# omnivoice/checkpoints tree). Default: ~/tts-05172026
# TTS_WORKDIR=/mnt/e/wsl-projects/tts-05172026

# OmniVoice model variants shown as the two interface models:
#   base      — stock model (default: k2-fsa/OmniVoice)
#   finetuned — auto-detected: repo models/omnivoice/best_finetuned (run
#               scripts/assemble_omnivoice_checkpoint.sh once after pulling),
#               else $TTS_WORKDIR/omnivoice/checkpoints/best_finetuned
# Override either slot explicitly:
# OMNIVOICE_BASE_MODEL_ID=k2-fsa/OmniVoice
# OMNIVOICE_FINETUNED_MODEL_ID=/path/to/checkpoint

# Directory of bundled clone voices. Default: <repo>/voices
# TTS_VOICES_DIR=

# ── Transcription worker (📝 التفريغ الصوتي), port 8084 ──────────
# The model is pinned to NAMAA-Space/cohere-transcribe-arabic-07-2026-int8 in the worker
# and is not configurable. INT8 — requires a CUDA GPU. Upload size follows the shared
# TTS_MAX_UPLOAD_BYTES above.
# TRANSCRIBE_DEVICE=auto            # or cuda:0
# TRANSCRIBE_MAX_NEW_TOKENS=256     # per audio chunk, not per file
