# Copy to .env and fill in. .env is gitignored.
# Required for the Auto-Compose agent (✨ التأليف التلقائي).
OPENAI_API_KEY=sk-...

# Flagship by default; override to gpt-5.5-pro (higher) or gpt-5.4-mini (cheaper).
OPENAI_MODEL=gpt-5.5

# Optional fixed temperature. Leave unset for GPT-5.x reasoning models (they reject it).
# OPENAI_TEMPERATURE=0.7

# ── Transcription worker (📝 التفريغ الصوتي), port 8084 ──────────
# INT8 checkpoint — requires a CUDA GPU. Swap for the fp16 original if you have the VRAM.
# TRANSCRIBE_MODEL_ID=NAMAA-Space/cohere-transcribe-arabic-07-2026-int8
# TRANSCRIBE_DEVICE=auto            # or cuda:0
# TRANSCRIBE_MAX_NEW_TOKENS=256     # per audio chunk, not per file
# TRANSCRIBE_MAX_UPLOAD_MB=100
